# User unit for the eggfriedrice.code daemon. Installed by `just install` to
# ~/.config/systemd/user/efrd.service. Run `loginctl enable-linger` once so the
# daemon keeps running without an open login session.
[Unit]
Description=eggfriedrice.code daemon (efrd)
# Allow up to 10 restarts in the default interval before systemd gives up.
StartLimitBurst=10

[Service]
# efrd sends READY=1 only after migrations finish and the socket is open.
Type=notify
ExecStart=%h/.local/bin/efrd
# `systemctl --user reload efrd` reads config.toml again without a restart.
ExecReload=kill -HUP $MAINPID
Restart=always
RestartSec=5
# An OOM kill of one hidden shell must not take the daemon down with it.
OOMPolicy=continue
# NOTE: no EFR_LOG here: the filter defaults to info, and a variable would win over the
# log key of config.toml, which reloads live.

[Install]
WantedBy=default.target
