---
source: crates/efr-cli/src/commands/config/tests.rs
expression: "effective(&ctx, &discovered)"
---
# The settings efr uses and where each one comes from.
# The daemon's own settings are not shown; efrd reads them itself.

[render]
theme = "gruvbox-dark"  # /c/efr/config.toml
colour = "truecolor"  # COLORTERM
formatted = true  # stdout is a terminal

[paths]
config = "/c/efr"  # XDG base directory
data = "/d/efr"  # EFR_DATA_DIR
state = "/s/efr"  # XDG base directory
runtime = "/run/user/1000/efr"  # XDG base directory

[daemon]
socket = "/tmp/elsewhere/daemon.sock"  # daemon.json

[login]
open_browser = true  # EFR_OPEN_BROWSER

[log]
filter = "debug"  # EFR_LOG
