+// Fabric mounts the children beside the button (the content view), and under it. So the
+// button takes every touch, and a tap never reaches a child. That is correct when a tap
+// opens the menu. When a long press opens it, a tap must reach the children: the button
+// then takes no touches, and the context menu goes on this view, which holds them.
+- (void)applyLongPressMode:(BOOL)longPress
+{
+    if (@available(iOS 14.0, *)) {
+        if (![_view conformsToProtocol:@protocol(UIContextMenuInteractionDelegate)]) {
+            return;
+        }
+        _view.userInteractionEnabled = !longPress;
+        if (longPress && _longPressInteraction == nil) {
+            _longPressInteraction = [[UIContextMenuInteraction alloc]
+                initWithDelegate:(id<UIContextMenuInteractionDelegate>)_view];
+            [self addInteraction:_longPressInteraction];
+        } else if (!longPress && _longPressInteraction != nil) {
+            [self removeInteraction:_longPressInteraction];
+            _longPressInteraction = nil;
+        }
+    }
+}
