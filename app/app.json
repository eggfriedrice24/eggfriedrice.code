{
  "expo": {
    "name": "efr",
    "slug": "efr",
    "version": "0.0.13",
    "orientation": "portrait",
    "scheme": "efr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d111a",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "dev.eggfriedrice.efr",
      "icon": "./assets/icon/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "efr uses the camera to scan a pairing code and to take photos that you attach.",
        "NSMicrophoneUsageDescription": "efr turns your speech into text on this iPhone. The audio does not leave the iPhone.",
        "NSSpeechRecognitionUsageDescription": "efr turns your speech into text on this iPhone. The audio does not leave the iPhone."
      }
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "recordAudioAndroid": false }],
      "expo-secure-store",
      [
        "expo-local-authentication",
        { "faceIDPermission": "efr checks that it is you when it opens." }
      ],
      "expo-sqlite",
      ["expo-image-picker", { "photosPermission": false }],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "419d2f79-b2ca-4c12-9a28-b97fc000bbe5"
      }
    },
    "owner": "eggfriedrice"
  }
}
