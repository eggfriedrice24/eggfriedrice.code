{
  "expo": {
    "name": "efr",
    "slug": "efr",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "efr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d111a",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "dev.eggfriedrice.efr",
      "icon": "./assets/icon/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "efr uses the camera to scan the pairing code that efr device add shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "419d2f79-b2ca-4c12-9a28-b97fc000bbe5"
      }
    },
    "owner": "eggfriedrice"
  }
}
