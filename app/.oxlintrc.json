{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react-perf is off: its rules flag what the React Compiler memoizes.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2022": true
  },
  "rules": {
    // The JSX runtime of React 17 and later needs no React in scope.
    "react/react-in-jsx-scope": "off",
    // Its fix is Array#toSorted (ES2023), which Hermes may lack. Sort a fresh copy.
    "unicorn/no-array-sort": "off",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",
    // File names are kebab-case (app/AGENTS.md, plan section 3).
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    // The React Compiler memoizes, so no code memoizes by hand. Loops use RN Animated
    // with the native driver, so no JS runs on each frame. Each override below that sets
    // this rule must repeat these paths, because an override replaces the whole rule.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["memo", "useMemo", "useCallback"],
            "message": "The React Compiler memoizes. Do not memoize by hand."
          },
          {
            "name": "react-native-reanimated",
            "importNames": ["withRepeat"],
            "message": "Loops use RN Animated.loop with the native driver."
          }
        ]
      }
    ],
    // Hermes may not have these. lib ES2022 also stops the array methods at type level.
    "no-restricted-properties": [
      "error",
      { "property": "toSorted", "message": "Hermes may lack it. Sort a copy." },
      { "property": "toReversed", "message": "Hermes may lack it. Reverse a copy." },
      { "property": "toSpliced", "message": "Hermes may lack it. Splice a copy." },
      { "property": "Segmenter", "message": "Hermes has no Intl.Segmenter." }
    ],
    // The rules of the React Compiler: code that breaks them makes the compiler skip it.
    "react/purity": "error",
    "react/immutability": "error",
    "react/set-state-in-render": "error",
    "react/set-state-in-effect": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/incompatible-library": "error",
    "react/no-deriving-state-in-effects": "error",
    // The only import for its side effect is the CSS of uniwind.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      // Pure code: a .ts file outside use-*.ts and native/ names no React Native, Expo or
      // native list module, so it runs in Node under Vitest. A type import is allowed.
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["memo", "useMemo", "useCallback"],
                "message": "The React Compiler memoizes. Do not memoize by hand."
              },
              {
                "name": "react-native-reanimated",
                "importNames": ["withRepeat"],
                "message": "Loops use RN Animated.loop with the native driver."
              }
            ],
            "patterns": [
              {
                "group": [
                  "react-native",
                  "react-native-*",
                  "expo",
                  "expo-*",
                  "@expo/*",
                  "@react-native-*/**",
                  "@shopify/**",
                  "@legendapp/**"
                ],
                "message": "Pure code: no React Native or Expo module. Put platform code in native/ or a use-*.ts hook.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // Hooks, the platform adapters and the tests of a feature can use the platform.
      "files": ["src/**/use-*.ts", "src/**/native/**", "src/**/*.test.ts", "src/**/testing.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["memo", "useMemo", "useCallback"],
                "message": "The React Compiler memoizes. Do not memoize by hand."
              },
              {
                "name": "react-native-reanimated",
                "importNames": ["withRepeat"],
                "message": "Loops use RN Animated.loop with the native driver."
              }
            ]
          }
        ]
      }
    },
    {
      // lib and theme are pure, and import nothing from features or components.
      "files": ["src/lib/**", "src/theme/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["memo", "useMemo", "useCallback"],
                "message": "The React Compiler memoizes. Do not memoize by hand."
              },
              {
                "name": "react-native-reanimated",
                "importNames": ["withRepeat"],
                "message": "Loops use RN Animated.loop with the native driver."
              }
            ],
            "patterns": [
              {
                "group": [
                  "react-native",
                  "react-native-*",
                  "expo",
                  "expo-*",
                  "@expo/*",
                  "@react-native-*/**",
                  "@shopify/**",
                  "@legendapp/**"
                ],
                "message": "Pure code: no React Native or Expo module. Put platform code in native/ or a use-*.ts hook.",
                "allowTypeImports": true
              },
              {
                "group": ["@/features/**", "@/components/**"],
                "message": "lib and theme import nothing from features or components.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // The platform adapters of lib (src/lib/native) can use the platform, but still
      // import nothing from features or components.
      "files": ["src/lib/native/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["memo", "useMemo", "useCallback"],
                "message": "The React Compiler memoizes. Do not memoize by hand."
              },
              {
                "name": "react-native-reanimated",
                "importNames": ["withRepeat"],
                "message": "Loops use RN Animated.loop with the native driver."
              }
            ],
            "patterns": [
              {
                "group": ["@/features/**", "@/components/**"],
                "message": "lib and theme import nothing from features or components.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      // Tests and their fakes wait for each step in turn on purpose.
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/**/testing.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // The local Expo module keeps the names of the Expo module template.
      "files": ["modules/**"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    }
  ],
  // uniwind writes uniwind-types.d.ts again on each Metro run, in its own style.
  "ignorePatterns": ["node_modules/", "ios/", "android/", ".expo/", "dist/", "uniwind-types.d.ts"]
}
