{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2022": true
  },
  "rules": {
    // The JSX runtime of React 17 and later needs no React in scope.
    "react/react-in-jsx-scope": "off",
    // Its fix is Array#toSorted (ES2023), which Hermes may lack. Sort a fresh copy.
    "unicorn/no-array-sort": "off",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error"
  },
  "overrides": [
    {
      // The core, the protocol types, the connection and the store are pure TypeScript:
      // they run in Node under Vitest, so they name no React, React Native or Expo
      // module. The adapters to the platform live in src/*/native/ (see below).
      "files": ["src/core/**", "src/protocol/**", "src/net/**", "src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "react/**",
                  "expo",
                  "expo-*",
                  "expo/**",
                  "@expo/**",
                  "@/**"
                ],
                "message": "src/core, src/protocol, src/net and src/store are pure TypeScript: import only from them."
              }
            ]
          }
        ]
      }
    },
    {
      // The adapters that give the pure code a real WebSocket, clock or database.
      "files": ["src/net/native/**", "src/store/native/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "ios/", "android/", ".expo/", "dist/"]
}
