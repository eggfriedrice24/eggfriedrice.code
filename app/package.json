{
  "name": "efr-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "check:protocol": "node scripts/gen-protocol.mjs --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.28.8",
  "enriched-markdown": {
    "enableMath": false,
    "codeHighlightLanguages": [
      "rust",
      "bash",
      "typescript",
      "tsx",
      "javascript",
      "json",
      "yaml",
      "python",
      "go",
      "c",
      "markdown"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
