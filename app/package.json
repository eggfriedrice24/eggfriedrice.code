{
  "name": "efr-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "jest",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "check:protocol": "node scripts/gen-protocol.mjs --check",
    "gen:theme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-theme.mjs",
    "check:theme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-theme.mjs --check",
    "bundle:check": "expo export --platform ios --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-menu/menu": "2.0.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/pacer": "0.23.1",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/store": "0.11.2",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "uniwind": "1.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "test-renderer": "1.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.28.8",
  "enriched-markdown": {
    "enableMath": false,
    "codeHighlightLanguages": [
      "rust",
      "bash",
      "typescript",
      "tsx",
      "javascript",
      "json",
      "yaml",
      "python",
      "go",
      "c",
      "markdown"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
